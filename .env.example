# VaultMind v2 — Host Provider LLM API Configuration
# Copy this file to `.env` (which is git-ignored) so VaultMind automatically
# selects a live cloud host provider on startup for your hackathon demo video!

# Option 1: Google Gemini 2.5 Flash (Recommended — free tier available at aistudio.google.com)
GEMINI_API_KEY=

# Option 2: OpenAI GPT-4o-mini
OPENAI_API_KEY=

# Option 3: AWS Bedrock Converse API (Amazon Nova / Claude via Bedrock API Key)
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
